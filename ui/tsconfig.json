{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "allowJs": false,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "react": [
        "./node_modules/@types/react/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "../design/components/index.d.ts"
  ]
}

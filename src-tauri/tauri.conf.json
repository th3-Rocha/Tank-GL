{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tank Studio",
  "identifier": "io.github.th3rocha.tankstudio",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "windows": [
      { "title": "Tank Studio", "width": 1280, "height": 860, "minWidth": 760, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": ["icons/icon.png"]
  }
}
